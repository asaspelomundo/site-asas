# ==========================================================================
#  Asas Pelo Mundo — regras do servidor
#  Hostinger (LiteSpeed, que lê este arquivo como o Apache).
#  Domínio principal: www.asaspelomundo.com
#  Para trocar o domínio principal, veja "Trocar o domínio" no README.
# ==========================================================================

# Abre o index.html quando o endereço é só a pasta (ex.: https://www.asaspelomundo.com/).
DirectoryIndex index.html

# Não mostra a lista de arquivos de uma pasta (ex.: /assets/ responde 403).
Options -Indexes

# Página exibida quando um ARQUIVO não existe (ex.: /assets/foto-antiga.png).
# Endereços de PÁGINA que não existem vão para a página inicial (regra 3).
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 1. Domínio principal ---------------------------------------------
  # asaspelomundo.com, asaspelomundo.com.br e www.asaspelomundo.com.br
  # vão direto (301, já em https) para o mesmo caminho em www.asaspelomundo.com.
  # Exemplo: http://asaspelomundo.com.br/?x=1 → https://www.asaspelomundo.com/?x=1
  # Outros endereços, como o domínio temporário da Hostinger, não passam por aqui.
  RewriteCond %{HTTP_HOST} ^(www\.)?asaspelomundo\.com(\.br)?$ [NC]
  RewriteCond %{HTTP_HOST} !=www.asaspelomundo.com [NC]
  RewriteRule ^ https://www.asaspelomundo.com%{REQUEST_URI} [R=301,L]

  # --- 2. Sempre https ---------------------------------------------------
  # http://www.asaspelomundo.com/... → https://www.asaspelomundo.com/...
  # A segunda condição evita repetir o redirecionamento quando o https é
  # tratado antes do servidor (CDN ou proxy que avisa por X-Forwarded-Proto).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- 3. Páginas antigas → página inicial ----------------------------------
  # O site antigo (app do Lovable) tinha endereços como /servicos e /contato.
  # Um endereço sem extensão que não existe aqui vai, com 301, para a página inicial.
  # Arquivos que não existem (com extensão, como .png ou .js) recebem a 404.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,5}$
  RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L]
</IfModule>

# --- Cache no navegador -------------------------------------------------
<IfModule mod_headers.c>
  # CSS e JS: 1 ano. O HTML pede css/style.css?v=N e js/main.js?v=N; quando eles
  # mudam, o número muda e o navegador baixa a versão nova na hora.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Imagens e fontes: 30 dias. Não têm ?v=; se uma foto for trocada mantendo
  # o mesmo nome, quem já visitou o site vê a nova em até 30 dias.
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Páginas, sitemap e robots: 5 minutos, para uma atualização aparecer rápido.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

# --- Compressão -----------------------------------------------------------
# O LiteSpeed da Hostinger já comprime sozinho (gzip/brotli). Este bloco vale
# para servidores Apache.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
